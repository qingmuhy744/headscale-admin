{
  "groups": { "group:dev": ["alice@"] },
  "tagOwners": { "tag:router": ["group:dev"], "tag:test": ["group:dev"] },
  "hosts": { "test-subnet": "10.77.0.0/24" },
  "grants": [{ "src": ["*"], "dst": ["*"], "ip": ["*"] }],
  "ssh": [{
    "action": "check",
